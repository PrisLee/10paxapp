rules_version = '2';

// 10 Pax — "the link is the key" access model.
//
// A group id is a long random string that only lives in the share link. Holding
// the link grants read and write to that group. This is capability security, not
// authentication: anyone with the link can edit anything in the group, and a
// leaked link cannot be revoked (make a new group instead).
//
// The one thing these rules DO enforce is that group ids cannot be discovered:
// `get` is allowed but `list` is not, so nobody can enumerate the collection and
// walk everyone's groups. Shape and size limits cap the damage a bad actor with a
// link can do.

service cloud.firestore {
  match /databases/{database}/documents {

    function validGroup() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'members', 'start', 'weeks', 'pick', 'updatedAt'])
        && d.name is string && d.name.size() <= 60
        && d.members is list && d.members.size() <= 30
        && d.start is string && d.start.size() == 10
        && d.weeks is int && d.weeks >= 1 && d.weeks <= 8
        && d.updatedAt is int;
    }

    function validAnswer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mask', 'name', 'updatedAt'])
        && d.mask is string && d.mask.size() <= 400
        && d.name is string && d.name.size() <= 40
        && d.updatedAt is int;
    }

    match /groups/{groupId} {
      // `get` only — deliberately no `list`, so group ids stay unguessable.
      allow get: if true;
      allow create, update: if validGroup();
      allow delete: if true;

      match /answers/{memberId} {
        // `list` is needed here: reading a group means reading all its answers.
        allow get, list: if true;
        allow create, update: if validAnswer();
        allow delete: if true;
      }
    }
  }
}
